# Maintainer: Ferramp contributors <https://github.com/SpankulatorX/ferramp>
pkgname=ferramp
pkgver=0.1.0
pkgrel=1
pkgdesc='Classic skinnable audio player (Winamp 2 look and feel, written in Rust)'
arch=('x86_64' 'aarch64')
url='https://github.com/SpankulatorX/ferramp'
license=('MIT' 'Apache-2.0')
depends=('alsa-lib' 'hicolor-icon-theme')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/ferramp" "$pkgdir/usr/bin/ferramp"
  install -Dm644 "assets/ferramp.desktop" "$pkgdir/usr/share/applications/ferramp.desktop"
  for size in 16 32 48 64 128 256; do
    install -Dm644 "assets/icons/ferramp-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/ferramp.png"
  done
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "LICENSE-APACHE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
