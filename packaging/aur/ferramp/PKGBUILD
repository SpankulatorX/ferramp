# Maintainer: Ferramp contributors <https://github.com/SpankulatorX/ferramp>
pkgname=ferramp
pkgver=0.2.0
pkgrel=1
pkgdesc='Classic skinnable audio player (Winamp 2 look and feel, written in Rust)'
arch=('x86_64' 'aarch64')
url='https://github.com/SpankulatorX/ferramp'
license=('MIT OR Apache-2.0')
depends=('alsa-lib' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
optdepends=('wine: classic Winamp plug-ins')
makedepends=('cargo')
# ring (TLS for internet radio) fails to link with makepkg's default LTO.
options=('!lto')
# The plug-in host is a Windows program (run under Wine) and needs a Windows
# toolchain to build, so it comes prebuilt from the same release.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "ferramp-plughost-x86-$pkgver.exe::$url/releases/download/v$pkgver/ferramp-plughost-x86.exe"
        "ferramp-plughost-x64-$pkgver.exe::$url/releases/download/v$pkgver/ferramp-plughost-x64.exe")
sha256sums=('652a9da54c6809302c4ba8fb47dbe7408f65f8cfcbd23799c791481da3438bd8'
            'f0512bc408149d412a05c56e354b1815d2d017cdf60b3a1c302c78472cee0ba7'
            '81c22be7387591b04a0af7e5b39cb7de66e2a3aa1630656735ccdd1b1617e588')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/ferramp" "$pkgdir/usr/bin/ferramp"
  for a in x86 x64; do
    install -Dm644 "$srcdir/ferramp-plughost-$a-$pkgver.exe" "$pkgdir/usr/lib/ferramp/ferramp-plughost-$a.exe"
  done
  install -Dm644 "assets/ferramp.desktop" "$pkgdir/usr/share/applications/ferramp.desktop"
  for size in 16 32 48 64 128 256; do
    install -Dm644 "assets/icons/ferramp-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/ferramp.png"
  done
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md NOTICE
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE-MIT LICENSE-APACHE NOTICE
}
